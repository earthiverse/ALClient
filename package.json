{
  "name": "alclient",
  "type": "module",
  "version": "1.0.0",
  "description": "A Node client for Adventureland (MMORPG)",
  "files": [
    "dist/*",
    "package.json",
    "README.md"
  ],
  "main": "dist/Index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage && rm -f ./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "format": "prettier --write .",
    "lint": "eslint",
    "test": "bun test --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earthiverse/alclient.git"
  },
  "keywords": [
    "alclient",
    "adventureland"
  ],
  "author": "Kent Rasmussen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/earthiverse/alclient/issues"
  },
  "homepage": "https://github.com/earthiverse/alclient#readme",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "^1.3.13",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.25.1",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.31.0"
  },
  "dependencies": {
    "alpathfinder": "^0.4.4",
    "socket.io-client": "^4.7.5",
    "typed-adventureland": "^0.0.56"
  }
}
