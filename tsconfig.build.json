{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "lib": ["ESNext"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "stripInternal": true,
    "target": "ESNext",
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts"]
}
